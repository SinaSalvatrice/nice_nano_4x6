# Keymap for nice_nano_4x6
# Example layout, adjust as needed
keymap {
  compatible = "zmk,keymap";
  base_layer {
    bindings = <&kp Q>, <&kp W>, <&kp E>, <&kp R>, <&kp T>, <&kp Y>,
               <&kp A>, <&kp S>, <&kp D>, <&kp F>, <&kp G>, <&kp H>,
               <&kp Z>, <&kp X>, <&kp C>, <&kp V>, <&kp B>, <&kp N>,
               <&kp 1>, <&kp 2>, <&kp 3>, <&kp 4>, <&kp 5>, <&kp 6>;
  };
}
